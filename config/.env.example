# Copy beside this file: cp config/.env.example config/.env
# (Also supported: repo root `.env`) Never commit `.env`.

# Deepgram speech-to-text (https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# Cartesia text-to-speech (https://play.cartesia.ai/)
CARTESIA_API_KEY=
# Voice UUID from Cartesia dashboard
CARTESIA_VOICE_ID=

# HTTP server (FastAPI / uvicorn)
PORT=8000

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Agent: echo (repeat the transcript) or brain (scoped FAQ)
AGENT_MODE=echo

# Brain / embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Direct-answer gate. Tune with scripts/eval_l1_threshold.py as the FAQ set grows.
BRAIN_L1_THRESHOLD=0.95
# L2: questions L1 misses go to Qdrant retrieval + a local Ollama model that answers
# only from the retrieved FAQs (or replies NOT_COVERED -> deflect).
# Evaluate with scripts/eval_brain_routes.py.
BRAIN_ENABLE_L2=false
# Skip the LLM entirely when the best Qdrant chunk scores below this.
BRAIN_L2_RELEVANCE_FLOOR=0.60
# Local LLM for L2 (ollama pull qwen2.5:3b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Layer 1 Redis Stack (docker-compose redis service)
REDIS_URL=redis://127.0.0.1:6379
REDIS_INDEX_NAME=brain:faq

# Optional Layer 2 Qdrant (docker-compose qdrant service)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=wise_where_is_money
